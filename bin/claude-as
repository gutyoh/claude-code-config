#!/usr/bin/env bash
# claude-as
# Path: bin/claude-as
#
# Run Claude Code as one of several accounts, each signed in once and chosen
# by the email it signed in with. Claude Code keeps one login per config
# directory (CLAUDE_CONFIG_DIR), so each account gets a home: ~/.claude and
# any ~/.claude-* holding a .claude.json. The extra homes link what is shared
# back to ~/.claude (settings, hooks, skills, plugins, session history...):
# every account is the same Claude Code, and a session started as one account
# continues as another.
#
# Usage:
#   claude-as                         list accounts
#   claude-as <email> [claude args]   run claude as the account that email signed in
#   claude-as <email> -a [args]       the same, with bypass permissions on from the start
#   claude-as -r <session id> [args]  resume a session as the account it last ran as
#   claude-as -c [args]               continue this folder's newest session the same way
#   claude-as --where [claude args]   that account's home, when the args resume a
#                                     session that last ran outside ~/.claude
#   claude-as --rc-name [claude args] the name to pass to --remote-control when
#                                     the args resume a session, so Remote
#                                     Control shows the session's own name
#   claude-as --host-alias            the machine's short name in session names
#   claude-as --move <email> [opts]   every Claude session in this machine's herdr
#                                     continues as that account (see --move below)
#   claude-as --add <email> [args]    new home for an account, then sign it in
#   claude-as --check                 every home: login, links, shared history
#   claude-as --relink                link shared items a home is missing
#
# The email is matched whole, in any case; never a part of one, which a later
# account could make name another. One email can sign in to several
# organizations (a personal plan and a team): add /<organization>, /<plan> or
# /<organization id>, as in `claude-as me@example.com/team`. A home's path
# (`claude-as ~/.claude-work`) names it directly.
# With CLAUDE_AS set, a first argument that is a claude option runs as it.
# A session resumed by id runs as the account it last ran as, which
# hooks/session-account.sh records; naming another account asks first.
# --add passes [args] to `claude auth login` (for example --sso).
#
# --move <email> [--pane <id>] [--dry-run] [--force] [--wait <seconds>]
# moves each Claude session herdr runs on this machine to that account, in its
# own pane: once the agent is idle it sends /exit, resumes the session there
# with this command, and waits until herdr sees the same session again. A
# session already on that account is left alone, and so is one whose Bash
# tool still runs background jobs, which would end with it, unless --force.
# The pane --move runs in moves last, once its agent finishes this turn.
# --wait bounds the wait for an agent to go idle (default 600).
#
# Env:
#   CLAUDE_AS          default account, written as on the command line
#   CLAUDE_AS_HOMES    homes to use, colon-separated (default: ~/.claude ~/.claude-*)
#   CLAUDE_AS_SHARED   the home the others link to (default: ~/.claude)
#   CLAUDE_AS_SHARE    names linked into each home (default: SHARE below)
#   CLAUDE_AS_CLAUDE   the claude to run (default: claude on PATH)
#   CLAUDE_HOST_ALIAS  the machine's short name; "off" leaves it out
#   XDG_STATE_HOME     where the session record is (default: ~/.local/state)

set -euo pipefail

# What every account shares. Anything else stays per account: the login,
# .claude.json, prompt history (Claude Code refuses a linked history.jsonl),
# the organization's managed settings, caches, and files a release adds.
SHARE="CLAUDE.md settings.json keybindings.json statusline.conf statusline.d agents commands
hooks output-styles plans plugins projects rules scripts skills file-history
tasks teams"

# Credentials Claude Code takes over a /login, whichever home is in use.
# These stand for another account and are dropped: the account was chosen.
DROPPED="ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN CLAUDE_SECURESTORAGE_CONFIG_DIR"
# These choose a gateway, a profile or a cloud provider: kept, with a warning.
OVERRIDES="ANTHROPIC_AUTH_TOKEN ANTHROPIC_PROFILE CLAUDE_CODE_USE_BEDROCK
CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY"

shared=${CLAUDE_AS_SHARED:-${HOME}/.claude}
shared=${shared%/}
ledger="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-as/sessions"
claude_bin=${CLAUDE_AS_CLAUDE:-claude}

die() {
    printf 'claude-as: %s\n' "$1" >&2
    exit "${2:-1}"
}

usage() {
    sed -n '/^# Usage:/,/^# Env:/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# ~ for HOME. Not ${1/#$HOME/\~}: bash 3.2 (macOS) keeps the backslash.
short() {
    case $1 in
        "${HOME}" | "${HOME}"/*) printf '~%s\n' "${1#"${HOME}"}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Claude Code keeps .claude.json beside ~/.claude unless CLAUDE_CONFIG_DIR is
# set; a home from an old release may still hold .config.json.
account_file() {
    if [[ -f $1/.config.json ]]; then
        printf '%s\n' "$1/.config.json"
    elif [[ $1 == "${HOME}/.claude" ]]; then
        printf '%s\n' "${HOME}/.claude.json"
    else
        printf '%s\n' "$1/.claude.json"
    fi
}

# Every home, the shared one first. Another tool's ~/.claude-something is
# not a home: a home has an account file.
# A reader may stop at the home it wants. Started with SIGPIPE ignored, as
# from herdr or Claude Code, a write after that fails instead of ending this
# quietly, so a failed write ends it here, without a message.
homes() {
    local h
    if [[ -n ${CLAUDE_AS_HOMES:-} ]]; then
        tr ':' '\n' <<<"${CLAUDE_AS_HOMES}" | sed -e 's:/*$::' -e '/^$/d' 2>/dev/null
        return 0
    fi
    if [[ -d ${shared} ]]; then
        printf '%s\n' "${shared}" 2>/dev/null || return 0
    fi
    for h in "${HOME}"/.claude-*; do
        [[ -d ${h} && ! -L ${h} && ${h} != "${shared}" && -f $(account_file "${h}") ]] || continue
        printf '%s\n' "${h}" 2>/dev/null || return 0
    done
    return 0
}

# One line per home, fields split by the unit separator so an empty one
# survives `read`: home, email, organization, plan, org id.
# The plan is the organization type plus the rate tier Claude Code refreshes
# at start, so a new plan shows up without a change here.
accounts() {
    local home file
    while IFS= read -r home; do
        file=$(account_file "${home}")
        if [[ -r ${file} ]]; then
            jq -r --arg h "${home}" '.oauthAccount // {} | [$h, .emailAddress // "",
                .organizationName // "",
                ((.organizationType // "" | sub("^claude_"; ""))
                  + ((.userRateLimitTier // .organizationRateLimitTier // "")
                     | sub("^default_(claude_)?"; "")
                     | if . == "" or . == "ai" or test("^raven") then "" else "/" + . end)),
                .organizationUuid // ""] | join("\u001f")' "${file}" 2>/dev/null \
                || printf '%s\037\037\037\037\n' "${home}" 2>/dev/null || return 0
        else
            # As in homes: a reader that stopped ends this quietly.
            printf '%s\037\037\037\037\n' "${home}" 2>/dev/null || return 0
        fi
    done < <(homes)
}

list() {
    local home email org plan uuid
    printf '%-36s %-14s %-24.24s %s\n' EMAIL PLAN ORGANIZATION HOME
    while IFS=$'\037' read -r home email org plan uuid; do
        printf '%-36s %-14s %-24.24s %s\n' "${email:-(not signed in)}" "${plan:--}" \
            "${org:--}" "$(short "${home}")"
    done < <(accounts)
}

# The one home <who> names: "<email>[/<organization, plan or org id>]", or the
# home's own path. Each part must match whole, so adding an account never
# changes what an existing name runs.
resolve() {
    local want who qual home email org plan uuid keys="" near=""
    local -a found=()
    if [[ $1 == /* || $1 == "~/"* ]]; then
        want="${HOME}/${1#"~/"}"
        [[ $1 == /* ]] && want=$1
        want=${want%/}
        while IFS= read -r home; do
            [[ ${home} == "${want}" ]] && {
                printf '%s\n' "${home}"
                return
            }
        done < <(homes)
        die "$1 is not a home; run claude-as to list them"
    fi
    want=$(lower "$1")
    who=${want%%/*}
    qual=""
    [[ ${want} == */* ]] && qual=${want#*/}
    while IFS=$'\037' read -r home email org plan uuid; do
        [[ -n ${email} ]] || continue
        if [[ $(lower "${email}") != "${who}" ]]; then
            [[ -n ${who} && $(lower "${email}") == *"${who}"* ]] && near+="  ${email}"$'\n'
            continue
        fi
        if [[ -n ${qual} && ${qual} != "$(lower "${org}")" && ${qual} != "$(lower "${uuid}")" &&
        ${qual} != "${plan}" && ${qual} != "${plan%%/*}" ]]; then
            continue
        fi
        found+=("${home}")
    done < <(accounts)
    # One account signed in to several homes is still one account: the
    # shared home, or else the first, runs it.
    if ((${#found[@]} > 1)); then
        while IFS=$'\037' read -r home email org plan uuid; do
            for want in "${found[@]}"; do
                [[ ${home} == "${want}" ]] && keys+="$(lower "${email}")/${uuid}"$'\n'
            done
        done < <(accounts)
        if (($(printf '%s' "${keys}" | sort -u | grep -c .) == 1)); then
            home=${found[0]}
            for want in "${found[@]}"; do
                [[ ${want} == "${shared}" ]] && home=${want}
            done
            printf 'claude-as: one account in %d homes; using %s\n' "${#found[@]}" "$(short "${home}")" >&2
            found=("${home}")
        fi
    fi
    case ${#found[@]} in
        0)
            if [[ -n ${near} ]]; then
                printf '%s' "${near}" | sort -u >&2
                die "no account is '$1'; name one by its whole email, as listed above"
            fi
            die "no account is '$1'; run claude-as to list them, or claude-as --add <email>"
            ;;
        1) printf '%s\n' "${found[0]}" ;;
        *)
            for home in "${found[@]}"; do
                printf '  %s\n' "$(accounts_of "${home}")" >&2
            done
            die "'$1' names ${#found[@]} accounts; add /<organization>, /<plan> or /<organization id>"
            ;;
    esac
}

# The shortest whole name for <home>'s account: its email, or the email with
# the plan, or with the organization id when two of its organizations share one.
name_of() {
    local home email org plan uuid me="" family="" ids="" same=""
    while IFS=$'\037' read -r home email org plan uuid; do
        [[ ${home} == "$1" ]] && {
            me=$(lower "${email}")
            family=${plan%%/*}
            ids=${uuid}
        }
    done < <(accounts)
    while IFS=$'\037' read -r home email org plan uuid; do
        [[ $(lower "${email}") == "${me}" && ${uuid} != "${ids}" ]] && same+="${plan%%/*}"$'\n'
    done < <(accounts)
    if [[ -z ${same} ]]; then
        printf '%s\n' "${me}"
    elif ! grep -qx "${family}" <<<"${same}"; then
        printf '%s/%s\n' "${me}" "${family}"
    else
        printf '%s/%s\n' "${me}" "$(lower "${ids}")"
    fi
}

accounts_of() {
    local home email org plan uuid
    while IFS=$'\037' read -r home email org plan uuid; do
        [[ ${home} == "$1" ]] \
            && printf '%s/%s (%s, %s, %s)\n' "${email}" "${plan}" "${org}" "${uuid}" "$(short "${home}")"
    done < <(accounts)
}

# The session `--continue` reopens: Claude Code's newest conversation for
# this directory, whose folder name is the path with every character but
# letters and digits made a dash. Claude Code counts those characters in
# UTF-16 units, which sed cannot do for a non-ASCII path, so a folder that
# is not where the name says is found by the cwd its transcripts record.
continued_id() {
    local cwd dir file newest=""
    cwd=$(pwd -P)
    dir="${shared}/projects/$(printf '%s' "${cwd}" | sed 's/[^A-Za-z0-9]/-/g')"
    [[ -d ${dir} ]] || dir=$(project_dir_by_cwd "${cwd}")
    [[ -n ${dir} ]] || return 0
    for file in "${dir}"/*.jsonl; do
        if [[ -f ${file} && (-z ${newest} || ${file} -nt ${newest}) ]]; then
            newest=${file}
        fi
    done
    [[ -z ${newest} ]] || basename "${newest}" .jsonl
}

# The project folder whose transcripts ran in <cwd>: Claude Code writes the
# cwd on a transcript's first lines, so three transcripts per folder suffice.
project_dir_by_cwd() {
    local cwd=$1 dir file n
    for dir in "${shared}"/projects/*/; do
        n=0
        for file in "${dir}"*.jsonl; do
            [[ -f ${file} ]] || break
            # No grep -q: an early exit would SIGPIPE head, and pipefail
            # would then report a match as a failure.
            if head -n 50 "${file}" | grep -F "\"cwd\":\"${cwd}\"" >/dev/null; then
                printf '%s\n' "${dir%/}"
                return 0
            fi
            n=$((n + 1))
            ((n < 3)) || break
        done
    done
}

# The session id a claude command line resumes, when it names one or
# continues this directory's newest.
resumed_id() {
    local prev="" arg continued=""
    for arg in "$@"; do
        case ${prev}:${arg} in
            -r:-* | --resume:-*) ;;
            -r:* | --resume:*)
                printf '%s\n' "${arg}"
                return
                ;;
            *:--resume=*)
                printf '%s\n' "${arg#--resume=}"
                return
                ;;
            *:-c | *:--continue) continued=1 ;;
            *) ;;
        esac
        prev=${arg}
    done
    [[ -z ${continued} ]] || continued_id
}

# The full id a resume argument names: an id, or a session name ending in
# the id's first 8 characters (session-name.sh), when one recorded id has it.
full_id() {
    local short ids
    if [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        printf '%s\n' "$1"
    elif [[ $1 =~ -([0-9a-f]{8})$ && -r ${ledger} ]]; then
        short=${BASH_REMATCH[1]}
        ids=$(awk -F'\t' -v s="${short}" 'index($1, s) == 1 { print $1 }' "${ledger}" | sort -u)
        if [[ -n ${ids} && ${ids} != *$'\n'* ]]; then
            printf '%s\n' "${ids}"
        fi
    fi
}

# The home session <id> last ran in, while it is still a home: from the
# record hooks/session-account.sh keeps, else from the newest prompt each
# home's own history.jsonl holds for it (sessions older than the record).
last_home() {
    local id last="" home stamp best=0
    id=$(full_id "$1")
    [[ -n ${id} ]] || return 0
    [[ -r ${ledger} ]] && last=$(awk -F'\t' -v id="${id}" '$1 == id { h = $2 } END { print h }' "${ledger}")
    if [[ -z ${last} ]]; then
        while IFS= read -r home; do
            stamp=$(grep -F "\"sessionId\":\"${id}\"" "${home}/history.jsonl" 2>/dev/null | tail -n 1 \
                | grep -oE '"timestamp":[0-9]+' | grep -oE '[0-9]+$' || true)
            if [[ -n ${stamp} ]] && ((stamp > best)); then
                best=${stamp} last=${home}
            fi
        done < <(homes)
    fi
    [[ -n ${last} ]] || return 0
    while IFS= read -r home; do
        if [[ ${home} == "${last}" ]]; then
            printf '%s\n' "${home}"
            return 0
        fi
    done < <(homes)
}

# Resuming a session as another account than it last ran as. Both emails can
# start alike, and the shell offers the last command typed, so ask first.
confirm_switch() {
    local home=$1 id last was now answer
    shift
    id=$(full_id "$(resumed_id "$@")")
    last=$(last_home "${id}")
    [[ -n ${last} && ${last} != "${home}" ]] || return 0
    was=$(name_of "${last}")
    now=$(name_of "${home}")
    [[ -n ${was} && ${was} != "${now}" ]] || return 0
    printf 'claude-as: session %s last ran as %s\n' "${id}" "${was}" >&2
    # --move asked already, for this one session.
    if [[ ${CLAUDE_AS_CONFIRMED:-} == "${id}" ]]; then
        printf 'claude-as: continuing it as %s\n' "${now}" >&2
        return 0
    fi
    if [[ -t 0 && -t 2 ]]; then
        printf 'Continue it as %s? [y/N] ' "${now}" >&2
        read -r answer || answer=""
        [[ ${answer} == [yY]* ]] || die "not resumed; as before: claude-as ${was} -r ${id}"
    else
        printf 'claude-as: continuing it as %s\n' "${now}" >&2
    fi
}

# Lowercase ASCII words joined by hyphens, at most <max> characters, as
# hooks/session-name.sh's slug.
slug() {
    local ascii
    ascii=$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -c 'a-z0-9' '-' | tr -s '-')
    ascii=${ascii#-}
    ascii=${ascii%-}
    while ((${#ascii} > $2)) && [[ ${ascii} == *-* ]]; do
        ascii=${ascii%-*}
    done
    printf '%s' "${ascii:0:$2}"
}

# The machine's short name, as hooks/session-name.sh's host_alias reads it
# for session names (tests/claude-as.bats holds the two equal): CLAUDE_HOST_ALIAS,
# else host_alias= in <home>'s statusline files, the last one set winning,
# else the hostname up to its first "." or "-". "off" is none.
host_alias() {
    local conf_dir=$1 alias="" file key value
    if [[ -n ${CLAUDE_HOST_ALIAS+set} ]]; then
        alias=${CLAUDE_HOST_ALIAS}
    else
        for file in "${conf_dir}/statusline.conf" "${conf_dir}/statusline.d"/*.conf \
            "${conf_dir}/statusline.local.conf"; do
            [[ -f ${file} ]] || continue
            while IFS='=' read -r key value || [[ -n ${key} ]]; do
                [[ ${key//[[:space:]]/} == host_alias ]] && alias=${value//[[:space:]]/}
            done <"${file}"
        done
        if [[ -z ${alias} ]]; then
            alias=${HOSTNAME:-$(uname -n 2>/dev/null)}
            alias=${alias%%.*}
            alias=${alias%%-*}
        fi
    fi
    [[ ${alias} == off ]] && return 0
    slug "${alias}" 12
}

# Whether a session started in <home> here connects Remote Control on its
# own, as Claude Code decides it: managed settings win, a project's own
# settings may only turn it off, the user's turn it on.
remote_control_on() {
    local home=$1 on="" file value
    value=$(jq -r '.remoteControlAtStartup' "${home}/settings.json" 2>/dev/null || true)
    [[ ${value} == true ]] && on=1
    for file in .claude/settings.json .claude/settings.local.json; do
        value=$(jq -r '.remoteControlAtStartup' "${file}" 2>/dev/null || true)
        [[ ${value} == false ]] && on=""
    done
    for file in /etc/claude-code/managed-settings.json \
        "/Library/Application Support/ClaudeCode/managed-settings.json"; do
        value=$(jq -r '.remoteControlAtStartup' "${file}" 2>/dev/null || true)
        [[ ${value} == true ]] && on=1
        [[ ${value} == false ]] && on=""
    done
    [[ -n ${on} ]]
}

# The name Remote Control should keep for the session these claude arguments
# resume in <home>, or nothing. Resumed, a session gets a made-up name
# instead of its own (anthropics/claude-code#59960), and one moving to
# another account is registered anew. Only a name given with
# --remote-control survives that, so a resume passes the session's own:
# -n/--name when given, else its newest title. Nothing for --print, a fork
# (a new session), a Remote Control choice already made, or a name the
# command line would read as an option.
rc_name() {
    local home=$1 arg prev="" given="" id file newest title=""
    shift
    for arg in "$@"; do
        case ${arg} in
            -p | --print | --fork-session | --remote-control | --remote-control=*) return 0 ;;
            --name=*) given=${arg#--name=} ;;
            *) [[ ${prev} == -n || ${prev} == --name ]] && given=${arg} ;;
        esac
        prev=${arg}
    done
    remote_control_on "${home}" || return 0
    id=$(full_id "$(resumed_id "$@")")
    [[ -n ${id} ]] || return 0
    title=${given}
    if [[ -z ${title} ]]; then
        # A folder moved or renamed keeps an older copy under its old name:
        # the newest transcript is the one Claude Code continues.
        newest=""
        for file in "${shared}"/projects/*/"${id}.jsonl"; do
            [[ -f ${file} && (-z ${newest} || ${file} -nt ${newest}) ]] && newest=${file}
        done
        if [[ -n ${newest} ]]; then
            # Claude Code writes the title again as the session goes on, so
            # its end holds the newest; the whole file only when it does not.
            title=$(tail -c 4000000 "${newest}" | grep -F '"type":"custom-title"' | tail -n 1 \
                | jq -r '.customTitle // empty' 2>/dev/null || true)
            [[ -n ${title} ]] || title=$(grep -F '"type":"custom-title"' "${newest}" | tail -n 1 \
                | jq -r '.customTitle // empty' 2>/dev/null || true)
        fi
    fi
    [[ -n ${title} && ${title} != -* && ${title} != *$'\n'* ]] || return 0
    printf '%s\n' "${title}"
}

# Credentials in the environment outrank every home's login.
warn_overrides() {
    local name set=""
    for name in ${OVERRIDES}; do
        [[ -n ${!name:-} ]] && set+=" ${name}"
    done
    [[ -z ${set} ]] || printf 'claude-as: warning:%s set; Claude Code uses it instead of the chosen login\n' "${set}" >&2
}

# The terminal multiplexer's pane: a probe run inside herdr would report its
# own session to the pane (herdr's Claude hook reads these), and the pane
# would then resume the probe's session, not the one it shows.
PANE_VARS="HERDR_ENV HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID HERDR_SOCKET_PATH"

# Run claude in <home> for a check or a login, never as the pane's session.
# ~/.claude runs with CLAUDE_CONFIG_DIR unset: set to any value, even that
# path, it names a different macOS Keychain entry.
in_home() {
    local home=$1 name
    shift
    for name in ${DROPPED} ${PANE_VARS}; do unset "${name}"; done
    if [[ ${home} == "${HOME}/.claude" ]]; then
        env -u CLAUDE_CONFIG_DIR "${claude_bin}" "$@"
    else
        CLAUDE_CONFIG_DIR=${home} "${claude_bin}" "$@"
    fi
}

# The launcher defaults of the claude shell function setup.sh installs, so an
# account starts as plain claude does: bypass permissions on Shift+Tab, or on
# from the start with -a, --unsafe, --bypass or -adskp first.
run_in() {
    local home=$1 name mode=--allow-dangerously-skip-permissions rc alias
    shift
    case ${1:-} in
        -a | --unsafe | --bypass | -adskp)
            shift
            mode=--dangerously-skip-permissions
            ;;
    esac
    rc=$(rc_name "${home}" "$@")
    [[ -z ${rc} ]] || set -- --remote-control "${rc}" "$@"
    set -- "${mode}" "$@"
    # Remote Control's made-up names start with the machine's short name.
    if [[ -z ${CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX:-} ]]; then
        alias=$(host_alias "${home}")
        [[ -z ${alias} ]] || export CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX="claude-${alias}"
    fi
    warn_overrides
    for name in ${DROPPED}; do unset "${name}"; done
    unset CLAUDE_AS_CONFIRMED
    if [[ ${home} == "${HOME}/.claude" ]]; then
        exec env -u CLAUDE_CONFIG_DIR "${claude_bin}" "$@"
    fi
    CLAUDE_CONFIG_DIR=${home} exec "${claude_bin}" "$@"
}

# Whether version $1 is $2 or later (dotted numbers).
at_least() {
    local i have want
    IFS=. read -ra have <<<"$1"
    IFS=. read -ra want <<<"$2"
    for i in 0 1 2; do
        ((${have[i]:-0} > ${want[i]:-0})) && return 0
        ((${have[i]:-0} < ${want[i]:-0})) && return 1
    done
    return 0
}

# Link each shared item <home> lacks; something already there is left alone.
link_shared() {
    local home=$1 name src dst
    [[ ${home} == "${shared}" ]] && return 0
    for name in ${CLAUDE_AS_SHARE:-${SHARE}}; do
        src="${shared}/${name}"
        dst="${home}/${name}"
        [[ -e ${src} ]] || continue
        if [[ -L ${dst} && $(readlink "${dst}") == "${src}" ]]; then
            continue
        elif [[ -e ${dst} || -L ${dst} ]]; then
            printf 'left alone  %s: not a link to %s\n' "$(short "${dst}")" "$(short "${src}")"
        else
            ln -s "${src}" "${dst}"
            printf 'linked      %s\n' "$(short "${dst}")"
        fi
    done
}

add() {
    local email=$1 home base n=1 line
    shift
    # The home and its account file are the account's alone.
    umask 077
    [[ ${email} =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "'${email}' is not an email" 2
    [[ -d ${shared} ]] || die "$(short "${shared}") does not exist; run claude once first"
    while IFS=$'\037' read -r home line _; do
        if [[ $(lower "${line}") == "$(lower "${email}")" ]]; then
            printf '%s is signed in already: %s\n' "${email}" "$(accounts_of "${home}")"
            printf 'Signing in again, for another of its organizations: pick it in the browser.\n'
        fi
    done < <(accounts)
    base="${HOME}/.claude-$(lower "${email}")"
    home=${base}
    while [[ -e ${home} ]]; do
        n=$((n + 1))
        home="${base}-${n}"
    done
    mkdir -p "${home}"
    chmod 700 "${home}"
    link_shared "${home}"
    # Skip the first-run wizard and keep the folders already trusted: the
    # account changes, the person and the machine do not.
    jq '{hasCompletedOnboarding: true, projects: ((.projects // {})
        | with_entries(select(.value.hasTrustDialogAccepted == true)
          | .value = {hasTrustDialogAccepted: true}))}' "$(account_file "${shared}")" \
        >"$(account_file "${home}")" 2>/dev/null \
        || jq -n '{hasCompletedOnboarding: true}' >"$(account_file "${home}")"
    chmod 600 "$(account_file "${home}")"
    printf 'Signing in %s in %s\n' "${email}" "$(short "${home}")"
    (cd / && in_home "${home}" auth login --email "${email}" "$@") \
        || die "sign-in did not finish; run it again: claude-as --add ${email}"
    added "${home}" "${email}"
}

# What the new login turned out to be, and why it may not work as hoped.
added() {
    local home=$1 email=$2 got org plan uuid other oemail ouuid
    IFS=$'\037' read -r _ got org plan uuid < <(CLAUDE_AS_HOMES=${home} accounts)
    [[ $(lower "${got}") == "$(lower "${email}")" ]] \
        || die "signed in as '${got:-nobody}', not ${email}; sign in again: CLAUDE_CONFIG_DIR=$(short "${home}") claude auth login"
    while IFS=$'\037' read -r other oemail _ _ ouuid; do
        [[ ${other} != "${home}" && -n ${uuid} && ${ouuid} == "${uuid}" &&
            $(lower "${oemail}") == "$(lower "${email}")" ]] \
            && printf 'note: %s is the same account and organization as %s\n' "$(short "${home}")" "$(short "${other}")"
    done < <(accounts)
    case ${plan} in
        free* | "") printf 'warning: %s has no paid plan; Claude Code needs Pro, Max, Team or Enterprise\n' "${email}" >&2 ;;
    esac
    printf 'Ready: claude-as %s\n' "$(name_of "${home}")"
}

# A transcript only the shared projects folder holds: a home that can resume
# it sees the shared history. Claude Code refuses to resume it without a
# prompt, before any model call, so the check costs no usage, and the
# transcript is removed once every home was asked.
CANARY_ID=00000000-0000-4000-8000-0000000c1a5e
canary_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-as/canary"
canary_key=$(printf '%s' "${canary_dir}" | sed 's/[^A-Za-z0-9]/-/g')

canary() {
    mkdir -p "${canary_dir}" "${shared}/projects/${canary_key}"
    jq -nc --arg id "${CANARY_ID}" --arg cwd "${canary_dir}" \
        '{type: "user", message: {role: "user", content: "claude-as canary"},
          uuid: "00000000-0000-4000-8000-00000000c1a5", parentUuid: null,
          sessionId: $id, cwd: $cwd, timestamp: "2026-01-01T00:00:00.000Z",
          isSidechain: false, userType: "external"}' \
        >"${shared}/projects/${canary_key}/${CANARY_ID}.jsonl"
}

canary_gone() {
    rm -f "${shared}/projects/${canary_key}/${CANARY_ID}.jsonl"
    rmdir "${shared}/projects/${canary_key}" "${canary_dir}" 2>/dev/null || true
}

check() {
    local problems=0 home email org plan uuid status out name src dst managed version
    canary
    # Claude Code gives each home its own Keychain entry from 2.1.144 on.
    if [[ $(uname -s) == Darwin ]]; then
        version=$("${claude_bin}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)
        if ! at_least "${version:-0}" 2.1.144; then
            printf 'FAIL  Claude Code %s keeps one Keychain login for every home; update it\n' "${version:-?}"
            problems=$((problems + 1))
        fi
    fi
    for managed in /etc/claude-code/managed-settings.json "/Library/Application Support/ClaudeCode/managed-settings.json"; do
        [[ -r ${managed} ]] && jq -e '.forceLoginOrgUUID // .forceLoginMethod' "${managed}" >/dev/null 2>&1 \
            && printf 'note: %s restricts logins; homes of other organizations may refuse to start\n' "${managed}"
    done
    while IFS=$'\037' read -r home email org plan uuid; do
        printf '%s  %s %s\n' "$(short "${home}")" "${email:-(not signed in)}" "${plan:+(${plan})}"
        status=$(cd / && in_home "${home}" auth status --json </dev/null 2>/dev/null || true)
        if jq -e '.loggedIn == true' <<<"${status}" >/dev/null 2>&1; then
            printf '  ok    signed in\n'
        else
            printf '  FAIL  not signed in: claude-as --add <email>\n'
            problems=$((problems + 1))
        fi
        if [[ ${home} != "${shared}" ]]; then
            for name in ${CLAUDE_AS_SHARE:-${SHARE}}; do
                src="${shared}/${name}"
                dst="${home}/${name}"
                [[ -e ${src} ]] || continue
                if ! [[ -L ${dst} && $(readlink "${dst}") == "${src}" ]]; then
                    printf '  FAIL  %s is not linked to %s (claude-as --relink)\n' "${name}" "$(short "${src}")"
                    problems=$((problems + 1))
                fi
            done
        fi
        out=$(cd / && in_home "${home}" -p --resume "${CANARY_ID}" </dev/null 2>&1 || true)
        if [[ ${out} == *"No conversation found"* ]]; then
            printf '  FAIL  cannot see the shared session history\n'
            problems=$((problems + 1))
        else
            printf '  ok    sees the shared session history\n'
        fi
    done < <(accounts)
    canary_gone
    ((problems == 0)) || die "${problems} problem(s)"
}

# --move: herdr's view of a pane, and what moving its Claude session needs.
# The options of the run in progress.
move_who="" move_dry=0 move_force=0 move_wait=600 move_stop=0 move_script="" move_recover=""

# "<status>\t<session id>" of the Claude agent in <pane>, or nothing.
pane_claude() {
    herdr pane get "$1" 2>/dev/null \
        | jq -r '.result.pane | select(.agent == "claude") | [.agent_status, (.agent_session.value // "")] | @tsv'
}

# The claude process in the foreground of <pane>: its pid, then one per line
# the flags a resume keeps: -a for bypass permissions, and the choices a
# launcher would not make again whose value is a plain word. --settings and
# --mcp-config stay behind: wrappers such as agent-router add them per
# account, and the old account's would layer over the new one's.
# Nothing when herdr shows no claude.
pane_claude_proc() {
    herdr pane process-info --pane "$1" 2>/dev/null | jq -r '
        def keep: "^--(model|permission-mode|add-dir|fallback-model)";
        def plain: "^[][A-Za-z0-9._/@:+~-]+$";
        [.result.process_info.foreground_processes[] | select((.argv[0] // "") | test("(^|/)claude$"))][0]
        | select(. != null)
        | .pid, (.argv as $a
            | (if any($a[]; . == "--dangerously-skip-permissions") then "-a" else empty end),
              (range(1; $a | length) as $i | $a[$i] as $f
               | if ($f | test(keep + "=")) and ($f | sub("^[^=]*="; "") | test(plain)) then $f
                 elif ($f | test(keep + "$")) and (($a[$i + 1] // "") | test(plain)) then "\($f)=\($a[$i + 1])"
                 else empty end))'
}

# The session claude <pid> runs, from the file Claude Code keeps per process in
# the home it runs as. herdr's view can be stale: a `claude -p` run from the
# pane's own Bash tool leaves herdr naming that run's session.
session_of_pid() {
    local home file newest=""
    while IFS= read -r home; do
        file="${home}/sessions/$1.json"
        [[ -f ${file} && (-z ${newest} || ${file} -nt ${newest}) ]] && newest=${file}
    done < <(homes)
    [[ -z ${newest} ]] || jq -r --argjson pid "$1" 'select(.pid == $pid) | .sessionId // empty' "${newest}" 2>/dev/null
}

# Background jobs the Bash tool of claude <pid> still runs: they end with it.
bash_jobs() {
    local child job
    for child in $(pgrep -P "$1" 2>/dev/null || true); do
        ps -o command= -p "${child}" 2>/dev/null | grep -F '/shell-snapshots/snapshot-' >/dev/null || continue
        for job in $(pgrep -P "${child}" 2>/dev/null || true); do
            printf '      %s\n' "$(ps -o command= -p "${job}" 2>/dev/null | cut -c1-120)"
        done
    done
}

# Session <id>'s newest transcript; a moved folder can leave an older copy.
session_transcript() {
    local file newest=""
    for file in "${shared}"/projects/*/"$1.jsonl"; do
        [[ -f ${file} && (-z ${newest} || ${file} -nt ${newest}) ]] && newest=${file}
    done
    [[ -z ${newest} ]] || printf '%s\n' "${newest}"
}

# The folder session <id> was launched in: its transcript's first cwd. Later
# ones follow the Bash tool's cd, and a resume from there re-roots the session
# (another project key, auto-memory and settings scope).
session_cwd() {
    local file
    file=$(session_transcript "$1")
    [[ -n ${file} ]] || return 0
    head -c 2000000 "${file}" | jq -Rr 'fromjson? | .cwd // empty' 2>/dev/null | head -n 1
}

# The flag for the permission mode session <id> was last in, which Shift+Tab
# changes after launch: -a for bypass, --permission-mode=<mode> otherwise,
# nothing for the default; nothing either when the transcript does not say.
session_mode() {
    local file mode
    file=$(session_transcript "$1")
    [[ -n ${file} ]] || return 0
    mode=$(tail -c 2000000 "${file}" | jq -Rr 'fromjson? | .permissionMode // empty' 2>/dev/null | tail -n 1)
    case ${mode} in
        bypassPermissions) printf -- '-a\n' ;;
        default) printf 'default\n' ;;
        "") ;;
        *[!A-Za-z]*) ;;
        *) printf -- '--permission-mode=%s\n' "${mode}" ;;
    esac
}

# Whether <pane>'s agent goes idle (or done) within <seconds>; false at once
# when the pane no longer runs a Claude agent, or the run is being stopped.
idle_within() {
    local pane=$1 left=$2 status _
    while :; do
        IFS=$'\t' read -r status _ <<<"$(pane_claude "${pane}")"
        [[ -n ${status} ]] || return 1
        [[ ${status} == idle || ${status} == "done" ]] && return 0
        ((left > 0 && !move_stop)) || return 1
        sleep 5
        left=$((left - 5))
    done
}

# The command that resumes session <id> as the account, in the pane's shell:
# this very script by its path (a claude-as on PATH may be an older one), from
# the session's folder, with the flags <pane>'s claude kept. A -a among them
# must come first, the one place run_in reads it. Values are quoted, as fish
# would read the brackets of a model such as opus[1m].
resume_command() {
    local id=$1 dir=$2 flag cmd=""
    shift 2
    [[ -z ${dir} ]] || cmd="cd '${dir}' && "
    cmd+="CLAUDE_AS_CONFIRMED=${id} '${move_script}' ${move_who}"
    for flag in "$@"; do
        if [[ ${flag} == *=* ]]; then cmd+=" ${flag%%=*}='${flag#*=}'"; else cmd+=" ${flag}"; fi
    done
    printf '%s --resume %s\n' "${cmd}" "${id}"
}

# Whether <pane>'s claude is gone: process <pid> when known, else herdr's view.
exited() {
    if [[ -n $2 ]]; then
        if kill -0 "$2" 2>/dev/null; then return 1; fi
        return 0
    fi
    [[ -z $(pane_claude "$1") ]]
}

# Drops session <id>'s line from this run's recovery file: it runs again, so
# typing its line into the pane would reach claude as a prompt.
recovered() {
    local rest
    rest=$(awk -F'\t' -v id="$1" '$2 != id' "${move_recover}")
    if [[ -z ${rest} ]]; then
        rm -f "${move_recover}"
    elif printf '%s\n' "${rest}" >"${move_recover}.new"; then
        mv -f "${move_recover}.new" "${move_recover}"
    fi
}

# Moves the session in <pane>: true when it moved or had nothing to do.
move_pane() {
    local pane=$1 status id home was pid line jobs dir cmd now real i exit_wait mode="" flag
    local -a flags=() kept=()
    IFS=$'\t' read -r status id <<<"$(pane_claude "${pane}")"
    if [[ -z ${id} ]]; then
        printf '%s: no Claude session id known; left alone\n' "${pane}"
        return 0
    fi
    pid=""
    while IFS= read -r line; do
        if [[ -z ${pid} ]]; then pid=${line}; else flags+=("${line}"); fi
    done < <(pane_claude_proc "${pane}")
    # The id goes into the resume: one that is not the session running there
    # would end that session and resume another.
    real=""
    [[ -z ${pid} ]] || real=$(session_of_pid "${pid}")
    if [[ -n ${real} && ${real} != "${id}" ]]; then
        printf '%s: left alone: herdr names session %s, but its claude (pid %s) runs %s\n' "${pane}" "${id}" "${pid}" "${real}"
        return 0
    fi
    if [[ -z $(session_transcript "${id}") ]]; then
        printf '%s: %s left alone: it has no transcript to resume\n' "${pane}" "${id}"
        return 0
    fi
    home=$(last_home "${id}")
    was=""
    [[ -z ${home} ]] || was=$(name_of "${home}")
    if [[ ${was} == "${move_who}" ]]; then
        printf '%s: %s already runs as %s\n' "${pane}" "${id}" "${was}"
        return 0
    fi
    jobs=""
    if [[ -z ${pid} ]]; then
        if ((!move_force)); then
            printf '%s: %s left alone: herdr shows no claude process, so its jobs cannot be checked\n' "${pane}" "${id}"
            printf '      move it anyway with --pane %s --force\n' "${pane}"
            return 0
        fi
    else
        jobs=$(bash_jobs "${pid}")
    fi
    if [[ -n ${jobs} ]] && ((!move_force)); then
        printf '%s: %s left alone: its Bash tool runs jobs that would end with it:\n%s\n' "${pane}" "${id}" "${jobs}"
        printf '      stop them, or move it anyway with --pane %s --force\n' "${pane}"
        return 0
    fi
    # The mode the session is in now outranks the one it was launched with,
    # and goes first.
    for flag in ${flags[@]+"${flags[@]}"}; do
        if [[ ${flag} == -a || ${flag} == --permission-mode=* ]]; then mode=${flag}; else kept+=("${flag}"); fi
    done
    flag=$(session_mode "${id}")
    [[ -z ${flag} ]] || mode=${flag}
    [[ ${mode} != default ]] || mode=""
    flags=(${mode:+"${mode}"} ${kept[@]+"${kept[@]}"})
    dir=$(session_cwd "${id}")
    # Single quotes in fish still read \\ and \'; bash reads neither.
    if [[ -n ${dir} && (! -d ${dir} || ${dir} == *[\'\\]* || ${dir} == *$'\n'*) ]]; then
        printf "%s: cannot resume from %s; using the pane's folder\n" "${pane}" "${dir}"
        dir=""
    fi
    cmd=$(resume_command "${id}" "${dir}" ${flags[@]+"${flags[@]}"})
    if ((move_dry)); then
        printf '%s: would move %s from %s to %s\n' "${pane}" "${id}" "${was:-an unknown account}" "${move_who}"
        [[ -z ${jobs} ]] || printf '      ending these jobs:\n%s\n' "${jobs}"
        printf '      by running: %s\n' "${cmd}"
        return 0
    fi
    if ! idle_within "${pane}" "${move_wait}"; then
        if ((move_stop)); then
            printf '%s: %s left alone: stopping\n' "${pane}" "${id}"
        else
            printf '%s: %s still busy after %s s, or gone; left alone\n' "${pane}" "${id}" "${move_wait}"
        fi
        return 1
    fi
    # Written before /exit, so a run cut short leaves how to finish it; dropped
    # once the session runs again, or never exited.
    printf '%s\t%s\t%s\n' "${pane}" "${id}" "${cmd}" >>"${move_recover}"
    # Through the agent, not the raw pane: herdr refuses an agent at a dialog.
    if ! herdr agent prompt "${pane}" /exit >/dev/null 2>&1; then
        recovered "${id}"
        printf '%s: %s did not take /exit (a dialog open?); left as it was\n' "${pane}" "${id}"
        return 1
    fi
    # A prompt that lands first runs before the queued /exit. The process is
    # the proof: a herdr that fails to answer looks like an exited agent, and
    # the resume would then be typed into it as a prompt.
    exit_wait=$((move_wait > 60 ? move_wait : 60))
    for ((i = 0; i < exit_wait; i++)); do
        exited "${pane}" "${pid}" && break
        sleep 1
    done
    if ! exited "${pane}" "${pid}"; then
        printf '%s: %s has /exit queued behind its turn; once it exits, run in its pane:\n      %s\n' "${pane}" "${id}" "${cmd}"
        return 1
    fi
    sleep 1
    herdr pane run "${pane}" "${cmd}" >/dev/null
    for ((i = 0; i < 90; i++)); do
        IFS=$'\t' read -r status now <<<"$(pane_claude "${pane}")"
        [[ ${now} == "${id}" ]] && break
        sleep 2
    done
    if [[ ${now} != "${id}" ]]; then
        printf '%s: %s did not come back within 3 min; its pane shows:\n' "${pane}" "${id}"
        herdr pane read "${pane}" --source recent-unwrapped --lines 12 2>/dev/null | sed 's/^/      /'
        printf '      to resume it: %s\n' "${cmd}"
        return 1
    fi
    recovered "${id}"
    # The account comes from session-account.sh's record of this start.
    for ((i = 0; i < 15; i++)); do
        home=$(last_home "${id}")
        [[ -n ${home} && $(name_of "${home}") == "${move_who}" ]] && break
        sleep 2
    done
    if [[ -z ${home} || $(name_of "${home}") != "${move_who}" ]]; then
        printf '%s: %s came back, but its record says %s, not %s\n' "${pane}" "${id}" "$(name_of "${home:-none}")" "${move_who}"
        return 1
    fi
    printf '%s: %s moved to %s\n' "${pane}" "${id}" "${move_who}"
}

# Runs the arguments in a session of their own, so neither the hangup nor a
# signal to the process group of the agent that started it reaches them.
detached() {
    if command -v setsid >/dev/null 2>&1; then
        exec setsid "$@"
    elif command -v perl >/dev/null 2>&1; then
        exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' "$@"
    fi
    exec "$@"
}

# --move <who> [--pane <id>] [--dry-run] [--force] [--wait <seconds>]
move() {
    local only="" self="" pane failed=0 state log
    local -a again=()
    move_who=$1
    shift
    while (($#)); do
        case $1 in
            --pane) only=${2:?--pane needs a pane id} && again+=(--pane "${only}") && shift ;;
            --dry-run) move_dry=1 ;;
            --force) move_force=1 && again+=(--force) ;;
            --wait) move_wait=${2:?--wait needs seconds} && again+=(--wait "${move_wait}") && shift ;;
            *) die "--move: unknown option $1" 2 ;;
        esac
        shift
    done
    [[ ${move_wait} =~ ^[0-9]+$ ]] || die "--wait takes whole seconds" 2
    command -v herdr >/dev/null 2>&1 || die "--move needs herdr"
    move_who=$(name_of "$(resolve "${move_who}")")
    move_script="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
    [[ ${move_script} != *"'"* ]] || die "--move: this script's path holds a quote: ${move_script}"
    state="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-as"
    mkdir -p "${state}"
    # One per run: only the sessions this run left exited, with their command.
    move_recover="${state}/move-$(date +%Y%m%dT%H%M%S)-$$.resume"
    [[ ${HERDR_ENV:-} == 1 ]] && self=${HERDR_PANE_ID:-}
    # Started by an agent, whose tool would be cut off in minutes and whose own
    # pane moves too: the whole run goes on detached, that pane last.
    if ((!move_dry)) && [[ -n ${self} && -n $(pane_claude "${self}") && -z ${CLAUDE_AS_MOVE_DETACHED:-} ]]; then
        log="${state}/move-$(date +%Y%m%dT%H%M%S).log"
        # A hangup stays ignored through exec; TERM still stops it between sessions.
        (
            trap '' HUP
            detached env CLAUDE_AS_MOVE_DETACHED=1 "${move_script}" --move "${move_who}" ${again[@]+"${again[@]}"}
        ) </dev/null >"${log}" 2>&1 &
        disown 2>/dev/null || true
        printf 'moving in the background, this pane last; follow it with: tail -f %s\n' "$(short "${log}")"
        printf 'stop it between sessions with: kill %s\n' "$!"
        return 0
    fi
    # Ctrl+C or TERM stops after the session in flight, never inside one: a
    # wait for a busy agent ends at once, a session past /exit is resumed.
    # A detached run ignores HUP from its start, so only INT and TERM land.
    trap 'move_stop=1' INT TERM HUP
    while IFS= read -r -u 3 pane; do
        [[ -n ${pane} ]] || continue
        [[ -z ${only} || ${pane} == "${only}" ]] || continue
        [[ ${pane} == "${self}" && -n ${CLAUDE_AS_MOVE_DETACHED:-} ]] && continue
        move_pane "${pane}" || failed=$((failed + 1))
        if ((move_stop)); then
            printf 'stopped; the sessions after %s were not moved\n' "${pane}"
            break
        fi
    done 3< <(herdr agent list 2>/dev/null | jq -r '[.result.agents[] | select(.agent == "claude")]
        | sort_by(if .agent_status == "idle" or .agent_status == "done" then 0 else 1 end) | .[].pane_id')
    # The pane that started a detached run moves last, once its turn is over.
    if [[ -n ${CLAUDE_AS_MOVE_DETACHED:-} && -n ${self} && ${move_stop} == 0 ]] && [[ -z ${only} || ${only} == "${self}" ]]; then
        move_pane "${self}" || failed=$((failed + 1))
    fi
    trap - INT TERM HUP
    if [[ -e ${move_recover} ]]; then
        printf 'exited and not resumed; run its line in its pane (pane, session, command):\n'
        sed 's/^/  /' "${move_recover}"
    fi
    ((failed == 0)) || die "${failed} session(s) not moved"
}

command -v jq >/dev/null 2>&1 || die "needs jq"

case ${1:-} in
    -h | --help) usage ;;
    --list) list ;;
    --add)
        [[ -n ${2:-} ]] || die "usage: claude-as --add <email> [claude auth login args]" 2
        shift
        add "$@"
        ;;
    --check) check ;;
    --move)
        [[ -n ${2:-} && ${2} != -* ]] || die "usage: claude-as --move <email> [--pane <id>] [--dry-run] [--force] [--wait <seconds>]" 2
        shift
        move "$@"
        ;;
    --where)
        shift
        home=$(last_home "$(resumed_id "$@")")
        [[ -z ${home} || ${home} == "${HOME}/.claude" ]] || printf '%s\n' "${home}"
        ;;
    --rc-name)
        shift
        home=${CLAUDE_CONFIG_DIR:-}
        [[ -n ${home} ]] || home=$(last_home "$(resumed_id "$@")")
        rc_name "${home:-${HOME}/.claude}" "$@"
        ;;
    --host-alias)
        host_alias "${CLAUDE_CONFIG_DIR:-${shared}}"
        ;;
    --relink)
        while IFS= read -r home; do link_shared "${home}"; done < <(homes)
        ;;
    "")
        if [[ -z ${CLAUDE_AS:-} ]]; then
            list
            exit 0
        fi
        home=$(resolve "${CLAUDE_AS}")
        run_in "${home}"
        ;;
    -*)
        home=$(last_home "$(resumed_id "$@")")
        if [[ -n ${home} ]]; then
            printf 'claude-as: as it last ran: %s\n' "$(accounts_of "${home}")" >&2
        else
            [[ -n ${CLAUDE_AS:-} ]] || die "name the account first (claude-as <who> $1), or set CLAUDE_AS" 2
            home=$(resolve "${CLAUDE_AS}")
        fi
        run_in "${home}" "$@"
        ;;
    *)
        home=$(resolve "$1")
        shift
        confirm_switch "${home}" "$@"
        [[ -t 2 ]] && printf 'claude-as: %s\n' "$(accounts_of "${home}")" >&2
        run_in "${home}" "$@"
        ;;
esac
