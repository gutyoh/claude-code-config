#!/usr/bin/env bash
# claude-secret-guard
# Path: claude-code-config/bin/claude-secret-guard
#
# Turns a fixed set of Read() deny rules for credential files on or off in your
# user settings. Off by default: nothing changes until you run `on`, and `off`
# removes exactly these rules, leaving every other key and rule as it was.
#
# Usage:
#   claude-secret-guard [status|on|off|list]
#
#   status   Print on, off or partial (some of the rules are present)
#   on       Back up settings.json, then add the rules that are missing
#   off      Back up settings.json, then remove these rules (and an empty
#            permissions block they leave behind)
#   list     Print the rules
#   -h, --help
#
# Settings: ${CLAUDE_CONFIG_DIR:-~/.claude}/settings.json. A symlinked file is
# updated at its target. Backups: <config dir>/backups/permissions/<UTC time>/.
#
# Exit: 0 done, 2 usage error or unreadable settings (nothing is written).
# Requires: jq

set -euo pipefail

# Backups hold the whole settings file, which can carry tokens in env.
umask 077

readonly CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
readonly SETTINGS="${CLAUDE_DIR}/settings.json"
readonly BACKUP_ROOT="${CLAUDE_DIR}/backups/permissions"

# Credential files Claude's file tools have no reason to open. The rules also
# cover Bash commands that name these paths (cat, grep -r, cp…), symlinks to
# them, Write and Edit; ssh -i, gh, git, docker, az and fnox keep working
# because those programs read the files themselves.
readonly RULES=(
    'Read(~/.oci/**)'
    'Read(~/.ssh/id_*)'
    'Read(~/.ssh/*.pem*)'
    'Read(~/.ssh/google_compute_engine)'
    'Read(~/.ssh/oci-free-a1-ed25519)'
    'Read(~/.ssh/workstation_drop)'
    'Read(~/.config/fnox/age.txt)'
    'Read(~/.azure/**)'
    'Read(~/.docker/config.json)'
    'Read(~/.doppler/**)'
    'Read(~/.config/gh/hosts.yml)'
    'Read(~/.claude/mcp-keys.env)'
    'Read(~/.bitwarden-ssh-agent.sock)'
)

usage() {
    sed -n '/^# Usage:/,/^# Requires:/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
}

die() {
    echo "claude-secret-guard: $1" >&2
    exit 2
}

rules_json() { printf '%s\n' "${RULES[@]}" | jq -R . | jq -s .; }

# The file a write must land in: a symlinked settings.json keeps its link.
target() {
    local f="${SETTINGS}" link
    while [[ -L ${f} ]]; do
        link=$(readlink "${f}")
        case ${link} in
            /*) f=${link} ;;
            *) f="$(dirname "${f}")/${link}" ;;
        esac
    done
    printf '%s' "${f}"
}

current() {
    if [[ -f ${SETTINGS} ]]; then
        jq -e 'type == "object"' "${SETTINGS}" >/dev/null 2>&1 || die "${SETTINGS} is not a JSON object; nothing changed"
        cat "${SETTINGS}"
    else
        echo '{}'
    fi
}

state() {
    local present
    present=$(current | jq --argjson r "$(rules_json)" '[(.permissions.deny // [])[] | select(. as $x | $r | index($x))] | unique | length')
    if ((present == 0)); then
        echo off
    elif ((present == ${#RULES[@]})); then
        echo on
    else
        echo "partial (${present}/${#RULES[@]})"
    fi
}

write() { # <jq program>
    local file new backup tmp
    file=$(target)
    new=$(current | jq --argjson r "$(rules_json)" "$1")
    if [[ -f ${file} ]]; then
        [[ ${new} == "$(jq . "${file}")" ]] && return 0
        backup="${BACKUP_ROOT}/$(date -u +%Y%m%dT%H%M%SZ)"
        mkdir -p "${backup}"
        cp -p "${file}" "${backup}/settings.json"
        chmod 600 "${backup}/settings.json"
        echo "backup: ${backup}/settings.json"
    fi
    mkdir -p "$(dirname "${file}")"
    tmp=$(mktemp "${file}.XXXXXX")
    printf '%s\n' "${new}" >"${tmp}"
    [[ -f ${file} ]] && chmod "$(stat -c %a "${file}" 2>/dev/null || stat -f %Lp "${file}")" "${tmp}"
    mv "${tmp}" "${file}"
}

command -v jq >/dev/null || die "jq is required"

case ${1:-status} in
    status) state ;;
    list) printf '%s\n' "${RULES[@]}" ;;
    on)
        write '.permissions = ((.permissions // {}) | .deny = ((.deny // []) + ($r - (.deny // []))))'
        echo "secret guard: $(state)"
        ;;
    off)
        write 'if .permissions then
                 .permissions.deny = ((.permissions.deny // []) - $r)
                 | if .permissions.deny == [] then del(.permissions.deny) else . end
                 | if .permissions == {} then del(.permissions) else . end
               else . end'
        echo "secret guard: $(state)"
        ;;
    -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
